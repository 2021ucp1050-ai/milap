# Copy to apps/api/.env for local overrides. The dev server runs without this file.

NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=file:data/milap.db
UPLOAD_DIR=uploads

# Show the email code in the API response. Forced off when NODE_ENV=production.
ALLOW_DEV_OTP=true

# Lets the app activate a 30-day plan without Razorpay. Forced off in production
# unless you set this to true on purpose.
ALLOW_DEMO_BILLING=true

# Optional. When these are set, checkout creates a Razorpay payment link
# instead of the demo plan. The webhook is what actually activates the plan.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional email delivery. Without this, use the development code on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Milap <no-reply@yourdomain.com>

# Comma-separated browser origins. Empty allows any origin (fine while the
# token is sent in the Authorization header, not in a cookie).
CORS_ORIGIN=
